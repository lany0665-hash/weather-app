#!/bin/bash
# 현재 스크립트가 위치한 디렉터리로 이동
cd "$(dirname "$0")"

echo "======================================================================"
echo "   기상청 API 기반 날씨 옷차림 추천 웹앱 (과학 수업 실습용)"
echo "======================================================================"
echo ""
echo "[1] 로컬 웹 서버(app.py)를 시작합니다..."
echo "[2] 웹 브라우저에서 http://localhost:8000 접속 중..."
echo ""
echo "* 서버를 종료하려면 이 터미널 창에서 [Ctrl + C] 를 누르세요."
echo "======================================================================"
echo ""

# macOS 기본 웹 브라우저 실행
open "http://localhost:8000"

# Python 3 서버 실행
python3 app.py
